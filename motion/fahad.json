    {"file": "app.js", "code": "// form → server → SQL ✨"},
    {"code": "form.addEventListener('submit',"},
    {"code": "  async (ev) => {"},
    {"code": "    ev.preventDefault();"},
    {"code": "    const data = Object.fromEntries("},
    {"code": "      new FormData(form));"},
    {"code": ""},
    {"code": "    await fetch('/api/messages', {"},
    {"code": "      method: 'POST',"},
    {"code": "      body: JSON.stringify(data),"},
    {"code": "    });"},
    {"code": "  });"},

    {"file": "schema.sql", "code": "CREATE TABLE messages ("},
    {"code": "  id INTEGER PRIMARY KEY,"},
    {"code": "  name TEXT NOT NULL,"},
    {"code": "  email TEXT NOT NULL,"},
    {"code": "  message TEXT NOT NULL,"},
    {"code": "  created_at TEXT DEFAULT"},
    {"code": "    (datetime('now'))"},
    {"code": ");"},

    {"file": "server.js", "code": "const db = new DatabaseSync('site.db');"},
    {"code": "db.exec(schema);"},
    {"code": ""},
    {"code": "const insert = db.prepare("},
    {"code": "  'INSERT INTO messages ' +"},
    {"code": "  '(name, email, message) ' +"},
    {"code": "  'VALUES (?, ?, ?)');"},
    {"code": ""},
    {"code": "if (url === '/api/messages') {"},
    {"code": "  const m = await readBody(req);"},
    {"code": "  insert.run(m.name, m.email,"},
    {"code": "             m.message);"},
    {"code": "}"},

