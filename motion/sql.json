   "code": ""
  },
  {
   "code": "-- 7) عدد الموظفين بكل قسم"
  },
  {
   "code": "SELECT d.name,"
  },
  {
   "code": "       COUNT(e.id)   AS staff,"
  },
  {
   "code": "       AVG(e.salary) AS avg_salary"
  },
  {
   "code": "FROM departments d"
  },
  {
   "code": "JOIN divisions v"
  },
  {
   "code": "  ON v.department_id = d.id"
  },
  {
   "code": "LEFT JOIN employees e"
  },
  {
   "code": "  ON e.division_id = v.id"
  },
  {
   "code": "GROUP BY d.id, d.name;"
  },
  {
