   "code": "-- 6) الربط: مين يشتغل وين؟",
   "file": "04_join.sql"
  },
  {
   "code": "SELECT e.name,"
  },
  {
   "code": "       v.name AS division,"
  },
  {
   "code": "       d.name AS department"
  },
  {
   "code": "FROM employees e"
  },
  {
   "code": "JOIN divisions v"
  },
  {
   "code": "  ON v.id = e.division_id"
  },
  {
   "code": "JOIN departments d"
  },
  {
   "code": "  ON d.id = v.department_id;"
  },
  {
   "show": "assets/sql/step09.png",
   "pane": "bottom",
   "label": "Results",
   "hold": 2.6
